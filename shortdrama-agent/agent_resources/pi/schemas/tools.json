    {
      "name": "shortdrama_asset_search",
      "description": "按自然语言查询资产；返回候选 ID，不自动选择同名资产。",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
