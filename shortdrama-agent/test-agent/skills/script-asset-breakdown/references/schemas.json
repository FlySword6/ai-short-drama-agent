{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentkit.local/short-drama/script-asset-breakdown.schema.json",
  "title": "Script Asset Breakdown Output",
  "description": "Root schema for script_breakdown, storyboard_breakdown, and prop_scene_task_breakdown. When ingest context is available, outputs may include storyboard_ingestion_request matching POST /v1/storyboard_ingestions (operationId: ingestStoryboardDecomposition); project_id may be resolved or created through listProjects/createProject, and project_shot_id may be resolved or created through lookupProjectShotId/createProjectShot before ingestion. When the user explicitly asks to create image generation tasks, outputs may include shot_image_generation_request matching POST /api/projects/shot-images (operationId: createShotImage).",
  "oneOf": [
    {
      "$ref": "#/$defs/ScriptBreakdownOutput"
    },
    {
      "$ref": "#/$defs/StoryboardBreakdownOutput"
    },
    {
      "$ref": "#/$defs/PropSceneTaskBreakdownOutput"
    }
  ],
  "$defs": {
    "Character": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "角色正式名称"
        },
        "identity": {
          "type": "string",
          "description": "角色身份定位"
        },
        "personality": {
          "type": "string",
          "description": "角色性格特征"
        },
        "relationship": {
          "type": "string",
          "description": "与其他角色的主要关系"
        },
        "visual_notes": {
          "type": "string",
          "description": "服装、外形、妆造、年龄感或可视化要点"
        }
      },
      "required": [
        "name",
        "identity",
        "personality",
        "relationship",
        "visual_notes"
      ]
    },
    "Scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "场景正式名称"
        },
        "time_and_place": {
          "type": "string",
          "description": "时间和地点"
        },
        "atmosphere": {
          "type": "string",
          "description": "场景氛围"
        },
        "story_function": {
          "type": "string",
          "description": "该场景承担的剧情功能"
        },
        "asset_notes": {
          "type": "string",
          "description": "场景资产制作提示"
        }
      },
      "required": [
        "name",
        "time_and_place",
        "atmosphere",
        "story_function",
        "asset_notes"
      ]
    },
    "Prop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "道具名称"
        },
        "purpose": {
          "type": "string",
          "description": "道具在剧情中的用途"
        },
        "appears_in": {
          "type": "string",
          "description": "出现的场景或镜头"
        },
        "visual_notes": {
          "type": "string",
          "description": "道具视觉要点"
        }
      },
      "required": ["name", "purpose", "appears_in", "visual_notes"]
    },
    "StoryboardShot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shot_no": {
          "type": "integer",
          "minimum": 1,
          "description": "镜头序号，从 1 开始连续递增"
        },
        "shot_type": {
          "type": "string",
          "enum": ["特写", "近景", "中景", "全景", "远景", "大全景"],
          "description": "常见景别"
        },
        "duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "镜头建议时长（秒）"
        },
        "narration": {
          "type": "string",
          "maxLength": 150,
          "description": "镜头描述，自然语言一段话"
        },
        "dialogue": {
          "type": "string",
          "description": "本镜原始台词；无台词时为（无台词）"
        },
        "character_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "本镜涉及角色名称"
        },
        "scene_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "本镜涉及场景名称"
        },
        "prop_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "本镜涉及道具名称"
        },
        "scene_continuity_key": {
          "type": "string",
          "pattern": "^SCENE_[0-9]{2,}$",
          "description": "同一物理场景连续块标识"
        },
        "scene_anchor": {
          "type": "string",
          "minLength": 10,
          "maxLength": 120,
          "description": "同场景稳定锚点，需包含地点、时间/光线、背景与环境状态"
        },
        "video_prompt": {
          "type": "string",
          "minLength": 20,
          "description": "可直接用于生成视频的自然中文提示词"
        }
      },
      "required": [
        "shot_no",
        "shot_type",
        "duration_sec",
        "narration",
        "dialogue",
        "character_names",
        "scene_names",
        "prop_names",
        "scene_continuity_key",
        "scene_anchor",
        "video_prompt"
      ]
    },
    "PropSceneTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_no": {
          "type": "integer",
          "minimum": 1,
          "description": "任务序号"
        },
        "task_name": {
          "type": "string",
          "description": "任务名称"
        },
        "task_category": {
          "type": "string",
          "description": "任务类别，如道具制作、场景搭建、道具调度、镜头配合"
        },
        "prop_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "关联道具名称"
        },
        "scene_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "关联场景名称"
        },
        "related_character_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "关联角色名称"
        },
        "source_excerpt": {
          "type": "string",
          "description": "支撑该任务的剧本原文摘录"
        },
        "objective": {
          "type": "string",
          "description": "该任务的制作目标"
        },
        "action_requirements": {
          "type": "string",
          "description": "动作与调度要求"
        },
        "visual_requirements": {
          "type": "string",
          "description": "外观、材质、光影、旧化、损耗等视觉要求"
        },
        "scene_continuity_key": {
          "type": "string",
          "pattern": "^SCENE_[0-9]{2,}$",
          "description": "关联场景连续块标识；无明确连续块时仍建议生成"
        },
        "scene_anchor": {
          "type": "string",
          "minLength": 10,
          "maxLength": 120,
          "description": "关联场景锚点"
        },
        "continuity_requirements": {
          "type": "string",
          "description": "跨镜头或跨任务的连续性要求"
        },
        "delivery_notes": {
          "type": "string",
          "description": "交付说明或后续制作建议"
        }
      },
      "required": [
        "task_no",
        "task_name",
        "task_category",
        "prop_names",
        "scene_names",
        "related_character_names",
        "source_excerpt",
        "objective",
        "action_requirements",
        "visual_requirements",
        "scene_continuity_key",
        "scene_anchor",
        "continuity_requirements",
        "delivery_notes"
      ]
    },
    "StoryboardAssetInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_key": {
          "type": "string",
          "description": "资产唯一 key，例如 character_01 / scene_02 / prop_03"
        },
        "asset_name": {
          "type": "string",
          "description": "资产显示名称"
        },
        "shot_no": {
          "type": "integer",
          "description": "资产首次或关键出现镜头号；未知时可省略"
        },
        "prompt_text": {
          "type": "string",
          "description": "可直接用于生成该资产的自然中文提示词"
        },
        "negative_prompt": {
          "type": "string",
          "description": "负向提示词"
        },
        "model_name": {
          "type": "string",
          "description": "模型名；有则透传"
        },
        "status": {
          "type": "string",
          "description": "资产状态；仅在调用方给出明确状态语义时透传"
        },
        "metadata": {
          "type": "object",
          "description": "资产附加元数据",
          "additionalProperties": true
        }
      },
      "required": ["prompt_text"]
    },
    "StoryboardAssetsInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StoryboardAssetInput"
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StoryboardAssetInput"
          }
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StoryboardAssetInput"
          }
        }
      }
    },
    "StoryboardShotInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_shot_id": {
          "type": "string",
          "format": "uuid",
          "description": "真实 project_shot_id；可由运行时直接提供，或先通过 lookupProjectShotId(project_id, episode_no, shot_no) 查询，未命中时通过 createProjectShot 创建获得"
        },
        "shot_no": {
          "type": "integer",
          "description": "镜头号"
        },
        "parent_generation_id": {
          "type": "string",
          "format": "uuid",
          "description": "父 generation ID；有则透传"
        },
        "revision_no": {
          "type": "integer",
          "description": "修订号；有则透传"
        },
        "revision_reason": {
          "type": "string",
          "description": "修订原因；有则透传"
        },
        "prompt_text": {
          "type": "string",
          "description": "镜头生成提示词，优先复用 storyboard.video_prompt"
        },
        "negative_prompt": {
          "type": "string",
          "description": "负向提示词"
        },
        "input_image_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_reference_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_storyboard_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generation_params": {
          "type": "object",
          "description": "建议承载 shot_type / duration_sec / continuity 等辅助字段",
          "additionalProperties": true
        },
        "status": {
          "type": "string",
          "description": "镜头状态；仅在调用方提供明确语义时填写"
        },
        "metadata": {
          "type": "object",
          "description": "镜头附加元数据",
          "additionalProperties": true
        },
        "generation_type": {
          "type": "string",
          "description": "生成类型",
          "default": "video"
        },
        "created_by": {
          "type": "string",
          "description": "创建者标识；有则透传"
        },
        "asset_keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "本镜关联资产 key 列表"
        }
      },
      "required": ["project_shot_id", "prompt_text"]
    },
    "StoryboardIngestionRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Request body aligned with POST /v1/storyboard_ingestions (operationId: ingestStoryboardDecomposition). Before constructing this payload, the caller may resolve or create project_id through listProjects/createProject and project_shot_id through lookupProjectShotId/createProjectShot.",
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid",
          "description": "真实 project_id；可由运行时直接提供，或先通过 listProjects(project_name) 查询，未命中时通过 createProject 创建获得"
        },
        "project_name": {
          "type": "string"
        },
        "episode_no": {
          "type": "integer"
        },
        "user_id": {
          "type": "string"
        },
        "user_name": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "decomposition_run_id": {
          "type": "string"
        },
        "assets": {
          "$ref": "#/$defs/StoryboardAssetsInput"
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/StoryboardShotInput"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["project_id", "shots"]
    },
    "ShotImageGenerationRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Request body aligned with POST /api/projects/shot-images (operationId: createShotImage). Field names intentionally follow the OpenAPI camelCase contract.",
      "properties": {
        "projectId": {
          "type": "string",
          "description": "真实 project_id；createShotImage 必填字段"
        },
        "projectName": {
          "type": "string",
          "maxLength": 128,
          "description": "项目名称；有则透传"
        },
        "projectPromptIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "真实项目提示词 ID 列表；只能使用 listProjectPrompts、ingestStoryboardDecomposition、createProjectPrompt 等工具返回的 ID，不能自造"
        },
        "promptTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "要创建图片任务的资产提示词类型；只能在 listProjectPrompts 已确认项目下存在匹配提示词时用于筛选"
        },
        "overwrite": {
          "type": "boolean",
          "default": false,
          "description": "是否覆盖已有图片生成任务"
        },
        "model": {
          "type": "string",
          "default": "gemini-3-pro-image-preview",
          "description": "图片生成模型"
        },
        "size": {
          "type": "string",
          "default": "1:1",
          "description": "图片比例或尺寸"
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "每个提示词生成数量"
        },
        "resolution": {
          "type": "string",
          "default": "1K",
          "description": "图片分辨率"
        },
        "generationParams": {
          "type": "object",
          "description": "额外生成参数",
          "additionalProperties": true
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128,
          "description": "创建者标识；有则透传"
        },
        "metadata": {
          "type": "object",
          "description": "图片生成任务附加元数据",
          "additionalProperties": true
        }
      },
      "required": ["projectId"]
    },
    "ScriptBreakdownOutput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "script_breakdown"
        },
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Character"
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scene"
          }
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Prop"
          }
        },
        "storyboards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StoryboardShot"
          }
        },
        "storyboard_ingestion_request": {
          "$ref": "#/$defs/StoryboardIngestionRequest"
        },
        "shot_image_generation_request": {
          "$ref": "#/$defs/ShotImageGenerationRequest"
        }
      },
      "required": ["mode", "characters", "scenes", "props", "storyboards"]
    },
    "StoryboardBreakdownOutput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "storyboard_breakdown"
        },
        "storyboards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StoryboardShot"
          }
        },
        "storyboard_ingestion_request": {
          "$ref": "#/$defs/StoryboardIngestionRequest"
        },
        "shot_image_generation_request": {
          "$ref": "#/$defs/ShotImageGenerationRequest"
        }
      },
      "required": ["mode", "storyboards"]
    },
    "PropSceneTaskBreakdownOutput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "prop_scene_task_breakdown"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PropSceneTask"
          }
        }
      },
      "required": ["mode", "tasks"]
    }
  }
}
