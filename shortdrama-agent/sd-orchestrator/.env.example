# Local task-state persistence. Do not commit real credentials.
TASK_REDIS_URL=redis://127.0.0.1:6379/0
# Set these separately for an authenticated Redis/Tair instance. Keep this
# local file out of Git; do not put credentials in agentkit.yaml.
# TASK_REDIS_USERNAME=default
# TASK_REDIS_PASSWORD=replace-with-a-secret

# Inject these three values through AgentKit Runtime environments in cloud.
# TASK_REDIS_URL=redis://<tair-host>:6379/0
# DATABASE_VIKINGMEM_COLLECTION=shortdrama_orchestrator_memory
# DATABASE_VIKINGMEM_PROJECT=shortdrama
