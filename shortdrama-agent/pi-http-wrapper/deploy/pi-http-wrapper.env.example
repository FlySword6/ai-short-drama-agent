# Copy to /etc/shortdrama/pi-http-wrapper.env, chmod 0600, then inject values via KMS/secret delivery.
# Comma-separated values support rotation: old and new tokens may coexist briefly.
PI_WRAPPER_BEARER_TOKENS=replace-with-secret-token
# Separate localhost-only credential used by the Pi extension callback.
PI_WRAPPER_INTERNAL_TOKEN=replace-with-distinct-internal-token
PI_WRAPPER_AUDIT_LOG=/var/log/pi-http-wrapper/audit.jsonl
PI_WRAPPER_SKILL_STATE_PATH=/var/lib/pi-http-wrapper/skills.json
PI_WRAPPER_CONTEXT_PATH=/var/lib/pi-http-wrapper/turn-context.json
PI_WRAPPER_TOOL_CALLBACK_URL=http://127.0.0.1:8787/internal/tool-calls
PI_WRAPPER_TOOL_RESULT_TIMEOUT_SECONDS=600
PI_WRAPPER_HOST=127.0.0.1
PI_WRAPPER_PORT=8787
PI_BIN=/usr/local/bin/pi
PI_WRAPPER_AGENTS_SKILLS_ROOT=/var/lib/pi-http-wrapper/.agents/skills
PI_WRAPPER_WORKBUDDY_SKILLS_ROOT=/var/lib/pi-http-wrapper/.workbuddy/skills
# Main environment selection and a credential issued by the dedicated Agent credential route.
# SHORTDRAMA_ENV accepts only a trusted environment name from the shortdrama-cli
# endpoint catalogue (prod/test/dev); URLs are rejected at startup. The backend
# address is never configured here — it comes from the CLI's trusted catalogue.
# Inject the token through the managed secret path; never commit real values.
SHORTDRAMA_ENV=prod
SHORTDRAMA_AGENT_TOKEN=replace-with-agent-credential
