[Unit]
Description=Shortdrama Pi HTTP Wrapper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=piwrapper
Group=piwrapper
WorkingDirectory=/opt/shortdrama/pi-http-wrapper/current
EnvironmentFile=/etc/shortdrama/pi-http-wrapper.env
ExecStart=/opt/shortdrama/pi-http-wrapper/current/.venv/bin/pi-http-wrapper
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/pi-http-wrapper /var/log/pi-http-wrapper
UMask=0077

[Install]
WantedBy=multi-user.target
