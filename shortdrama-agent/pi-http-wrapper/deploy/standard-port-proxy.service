[Unit]
Description=Standard Port HTTP Reverse Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=piproxy
Group=piproxy
WorkingDirectory=/opt/shortdrama/standard-port-proxy
ExecStart=/usr/bin/python3 proxy.py
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/shortdrama/standard-port-proxy
UMask=0077

[Install]
WantedBy=multi-user.target