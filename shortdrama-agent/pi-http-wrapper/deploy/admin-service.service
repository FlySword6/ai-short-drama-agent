[Unit]
Description=Shortdrama Admin Service (Multi-User Orchestrator)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=piadmin
Group=piadmin
WorkingDirectory=/opt/shortdrama/admin-service
EnvironmentFile=/etc/shortdrama/admin-service.env
ExecStart=/usr/bin/python3 server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/shortdrama/admin-service /var/lib/pi-http-wrapper/data
UMask=0077

[Install]
WantedBy=multi-user.target