[Unit]
Description=Shortdrama Business API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=piadmin
Group=piadmin
WorkingDirectory=/opt/shortdrama
EnvironmentFile=/etc/shortdrama/shortdrama-api.env
ExecStart=/usr/bin/python3 -m uvicorn shortdrama_api.main:app --host ${API_HOST:-127.0.0.1} --port ${API_PORT:-8000}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/shortdrama/shortdrama_api
UMask=0077

[Install]
WantedBy=multi-user.target