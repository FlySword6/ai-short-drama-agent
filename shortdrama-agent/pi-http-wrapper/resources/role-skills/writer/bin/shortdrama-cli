#!/bin/bash
# 编剧角色包装脚本 —— 硬限制兜底 + P3 加固（profile/flock/产物下载）
_X="${SHORTDRAMA_CLI:-$HOME/.shortdrama/bin/shortdrama-cli}"
if [ ! -x "$_X" ]; then echo "Error: backend not found" >&2; exit 1; fi

# --- 解析命令（跳过前导选项参数，找到真正的命令）---
ORIGINAL_ARGS=("$@")
cmd_parts=(); args=("$@"); i=0
while [ $i -lt ${#args[@]} ]; do
    arg="${args[$i]}"
    case "$arg" in --*) break ;; *) cmd_parts+=("$arg"); i=$((i+1)) ;; esac
done
if [ ${#cmd_parts[@]} -eq 0 ]; then echo "BLOCKED: no command specified" >&2; exit 1; fi
cmd_key="${cmd_parts[0]}"
[ ${#cmd_parts[@]} -ge 2 ] && cmd_key="${cmd_parts[0]} ${cmd_parts[1]}"
[ ${#cmd_parts[@]} -ge 3 ] && cmd_key="${cmd_parts[0]} ${cmd_parts[1]} ${cmd_parts[2]}"

CMD_MAIN="${cmd_parts[0]}"
CMD_SUB=""
[ ${#cmd_parts[@]} -ge 2 ] && CMD_SUB="${cmd_parts[1]}"

# --- 角色白名单（设置 ALLOWED=1 代替 exec）---
ALLOWED=0

# 查询命令（全角色放行）
case "$cmd_key" in
    doctor|config) ALLOWED=1 ;;
    auth\ *|auth) ALLOWED=1 ;;
    project\ list|project\ info) ALLOWED=1 ;;
    model\ search|model\ get) ALLOWED=1 ;;
    script\ list) ALLOWED=1 ;;
    scene\ list|scene\ get) ALLOWED=1 ;;
    task\ get|task\ list|task\ refresh) ALLOWED=1 ;;
    asset\ search|asset\ status) ALLOWED=1 ;;
    runs\ sync|runs\ status) ALLOWED=1 ;;
esac

# 编剧执行命令
if [ "$ALLOWED" = "0" ]; then
  case "$cmd_key" in
    script\ import|script\ import-episodes|script\ analyze|script\ breakdown-assets|project\ create|project\ update)
        echo " $* " | grep -q -- "--project" || set -- "$@" --project "$PI_PROJECT_ID"
        ALLOWED=1 ;;
    breakdown\ script|breakdown\ characters|breakdown\ storyboard)
        ALLOWED=1 ;;
  esac
fi

if [ "$ALLOWED" = "0" ]; then
  echo "BLOCKED: writer role cannot use '$cmd_key'" >&2; exit 1
fi

# ═══════════════════════════════════════════════════════════
# === P3 shortdrama 深度集成：profile 强制 + flock 锁 + 产物下载 ===
# ═══════════════════════════════════════════════════════════

REAL_CLI="$_X"

# --- profile 强制检查 ---
SHORTDRAMA_PROFILE="${SHORTDRAMA_PROFILE:-$PI_USER_ID}"
if [ -z "$SHORTDRAMA_PROFILE" ]; then
  echo "BLOCKED: SHORTDRAMA_PROFILE not set, refusing to run shortdrama-cli" >&2
  exit 1
fi

# --- profile 注入 ---
HAS_PROFILE=0
for arg in "$@"; do
  case "$arg" in
    --profile|--profile=*) HAS_PROFILE=1; break ;;
  esac
done
if [ "$HAS_PROFILE" = "0" ]; then
  set -- "$@" "--profile" "$SHORTDRAMA_PROFILE"
fi

# --- 写操作判定（用于 flock）---
IS_WRITE=0
case "$CMD_MAIN" in
  auth)
    case "$CMD_SUB" in
      login|refresh|logout) IS_WRITE=1 ;;
    esac ;;
  config)
    case "$CMD_SUB" in
      set|reset) IS_WRITE=1 ;;
    esac ;;
  result)
    case "$CMD_SUB" in
      accept|rerun) IS_WRITE=1 ;;
    esac ;;
  create) IS_WRITE=1 ;;
  edit) IS_WRITE=1 ;;
  render) IS_WRITE=1 ;;
  scene)
    case "$CMD_SUB" in
      create|update|move|duplicate|delete|batch) IS_WRITE=1 ;;
    esac ;;
  script)
    case "$CMD_SUB" in
      import|import-episodes|analyze|breakdown-assets) IS_WRITE=1 ;;
    esac ;;
  breakdown) IS_WRITE=1 ;;
  project)
    case "$CMD_SUB" in
      create|update|archive) IS_WRITE=1 ;;
    esac ;;
  asset)
    case "$CMD_SUB" in
      ingest) IS_WRITE=1 ;;
    esac ;;
  subtitle) IS_WRITE=1 ;;
  doctor)
    case "$CMD_SUB" in
      fix) IS_WRITE=1 ;;
    esac ;;
esac

# --- flock 锁 ---
LOCK_DIR="${SHORTDRAMA_CLI_PROFILE_DIR:-$HOME/.config/shortdrama-cli/profiles}"
LOCK_FILE="$LOCK_DIR/.lock"
mkdir -p "$LOCK_DIR"

# --- task get 单次执行 + 产物下载 ---
if [ "$CMD_MAIN" = "task" ] && [ "$CMD_SUB" = "get" ]; then
  OUTPUT=$(flock -w 30 "$LOCK_FILE" "$REAL_CLI" "$@" 2>&1)
  EXIT_CODE=$?
  echo "$OUTPUT"

  if [ "$EXIT_CODE" = "0" ]; then
    HAS_JSON=0
    for arg in "$@"; do
      [ "$arg" = "--json" ] && HAS_JSON=1 && break
    done
    if [ "$HAS_JSON" = "1" ]; then
      URLS=$(echo "$OUTPUT" | grep -oP '"(url|result_url|output_url|download_url)"\s*:\s*"\K[^"]+' 2>/dev/null || true)
      if [ -n "$URLS" ]; then
        OUT_DIR="${PI_WORKSPACE_DIR:-$HOME}/outputs"
        mkdir -p "$OUT_DIR"
        echo ""
        echo "[P3] 检测到产物 URL，正在下载到 $OUT_DIR/"
        echo "$URLS" | while IFS= read -r url; do
          if [ -n "$url" ] && [ "${url:0:5}" != "mock" ]; then
            FNAME=$(basename "$url" | cut -d'?' -f1)
            if curl -sL "$url" -o "$OUT_DIR/$FNAME" 2>/dev/null; then
              echo "  下载成功: $url -> $OUT_DIR/$FNAME"
            else
              echo "  下载失败: $url"
            fi
          elif [ "${url:0:5}" = "mock" ]; then
            echo "  跳过 mock URL: $url"
          fi
        done
      fi
    fi
  fi
  exit $EXIT_CODE
fi

# --- 普通命令执行（写操作加锁，读操作不加锁）---
if [ "$IS_WRITE" = "1" ]; then
  flock -w 30 "$LOCK_FILE" "$REAL_CLI" "$@"
  exit $?
else
  "$REAL_CLI" "$@"
  exit $?
fi
# === P3 patch end ===
