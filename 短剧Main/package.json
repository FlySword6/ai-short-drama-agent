{
  "name": "shortdrama-agent-ts",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend/shortdrama-rag-demo"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev-guard.mts && tsx watch src/server.ts",
    "dev:up": "tsx scripts/dev-up.mts",
    "dev:down": "tsx scripts/dev-down.mts",
    "dev:reset": "tsx scripts/dev-reset.mts",
    "dev:seed": "tsx scripts/dev-seed.mts",
    "db:migrate": "node dist/db/migrate.js",
    "check:architecture": "node scripts/check-v011-architecture.mjs && node scripts/check-repository-size.mjs",
    "check:test-branch-discipline": "node scripts/check-test-branch-discipline.mts",
    "prebuild": "npm run check:architecture",
    "build": "npm run build:frontend && tsc -p tsconfig.json",
    "build:frontend": "npm run build --workspace frontend/shortdrama-rag-demo",
    "pretypecheck": "npm run check:architecture",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:fable007-smoke && npm run typecheck:tier-unfreeze && npm run typecheck:sync-model-capabilities && npm run typecheck:eval-breakdown && npm run typecheck --workspace frontend/shortdrama-rag-demo",
    "typecheck:fable007-smoke": "tsc -p scripts/tsconfig.fable007-provider-smoke.json",
    "typecheck:tier-unfreeze": "tsc -p scripts/tsconfig.tier-unfreeze.json",
    "typecheck:sync-model-capabilities": "tsc -p scripts/tsconfig.sync-model-capabilities.json",
    "start": "node dist/server.js",
    "pretest": "npm run check:architecture && npm run check:director-mirror",
    "test": "npm run test:node && npm run test:tier-smoke-ledger-db && npm run test:s67-db && npm run test:s72-repair-db && npm run test:s84-db && npm run test:audio-pricing-seed-db && npm run test:seed-audio-db && npm run test:script-breakdown-db && npm run test:object-context-db && npm run test:asset-usage-db && npm run test:asset-media-repair-db && npm run test:reference-review-gate-db && npm run test:generation-quotes-db && npm run test:trash-retention-db && npm run test:s69-storage-deletion-db && npm run test:agent-credential-source-db && npm run test:auth-single-active-session-db && npm run test:wecom-auth-db && npm run test:generation-failed-list-db && npm run test:volc-asset-registration-db && npm run test:review-cross-tenant-authz-db && npm run test:casting-tasks-db && npm run test:vnext-script-db && npm run test:vnext-assets-db",
    "test:node": "node scripts/run-node-tests.mjs --list-files | xargs node --import tsx --test",
    "test:tier-smoke-ledger-db": "bash scripts/run-tier-smoke-ledger-db-test.sh",
    "test:s67-db": "bash scripts/run-s67-generation-accounting-actor-db-test.sh",
    "test:review-cross-tenant-authz-db": "bash scripts/run-review-cross-tenant-authz-db-test.sh",
    "test:ops-p0-db": "OPS_P0_ONLY=true bash scripts/run-s67-generation-accounting-actor-db-test.sh",
    "test:s72-repair-db": "bash scripts/run-s72-repair-db-test.sh",
    "test:s84-db": "bash scripts/run-s84-provider-cost-ledger-db-test.sh",
    "test:audio-pricing-seed-db": "bash scripts/run-audio-pricing-seed-db-test.sh",
    "test:seed-audio-db": "bash scripts/run-seed-audio-chain-db-test.sh",
    "test:script-breakdown-db": "bash scripts/run-script-breakdown-db-test.sh && bash scripts/run-lite-project-rebuild-concurrency-db-test.sh",
    "test:lite-project-rebuild-concurrency-db": "bash scripts/run-lite-project-rebuild-concurrency-db-test.sh",
    "test:lite-asset-usage-concurrency-db": "bash scripts/run-lite-asset-usage-concurrency-db-test.sh",
    "test:object-context-db": "bash scripts/run-object-context-db-test.sh",
    "test:asset-usage-db": "bash scripts/run-asset-usage-db-test.sh && bash scripts/run-lite-asset-usage-concurrency-db-test.sh",
    "test:asset-media-repair-db": "bash scripts/run-asset-media-repair-db-test.sh",
    "test:p0-orphan-db": "bash scripts/run-p0-orphan-db-tests.sh",
    "test:reference-review-gate-db": "bash scripts/run-reference-review-gate-db-test.sh",
    "test:generation-quotes-db": "bash scripts/run-generation-quotes-db-test.sh",
    "check:director-mirror": "tsx scripts/check-director-mirror.mts",
    "check:ci-db-coverage": "tsx scripts/check-ci-db-coverage.mts",
    "check:xyflow-compliance": "node scripts/check-xyflow-compliance.mjs",
    "e2e:sgoal06:midscene": "tsx scripts/e2e/run-product-e2e-report.mts --suite smoke",
    "e2e:sgoal07:asset-experience": "tsx scripts/e2e/run-product-e2e-report.mts --suite experience",
    "e2e:product:report": "tsx scripts/e2e/run-product-e2e-report.mts --suite all",
    "e2e:raw:sgoal06:midscene": "playwright test --config scripts/e2e/sgoal06-midscene.playwright.config.ts",
    "e2e:raw:sgoal07:asset-experience": "playwright test --config scripts/e2e/sgoal07-asset-experience.playwright.config.ts",
    "e2e:raw:cli-product": "tsx scripts/e2e/run-cli-product-suite.mts",
    "e2e:cli-paid-redlines": "tsx scripts/e2e/run-cli-paid-redlines.mts",
    "test:trash-retention-db": "bash scripts/run-trash-retention-db-test.sh",
    "test:s69-storage-deletion-db": "bash scripts/run-s69-storage-deletion-integrity-db-test.sh",
    "test:agent-credential-source-db": "bash scripts/run-agent-credential-source-db-test.sh",
    "test:auth-single-active-session-db": "bash scripts/run-auth-single-active-session-db-test.sh",
    "test:wecom-auth-db": "bash scripts/run-wecom-auth-db-test.sh",
    "test:generation-failed-list-db": "bash scripts/run-generation-failed-list-db-test.sh",
    "render:director-asset-previews": "tsx scripts/render-director-asset-previews.mts",
    "import:director-asset-previews": "tsx scripts/import-director-asset-previews.mts",
    "test:volc-asset-registration-db": "bash scripts/run-volc-asset-registration-db-test.sh",
    "test:casting-tasks-db": "bash scripts/run-casting-tasks-db-test.sh",
    "typecheck:eval-breakdown": "tsc -p scripts/tsconfig.eval-breakdown.json",
    "test:vnext-project-db": "bash scripts/e2e/vnext-project-db.sh",
    "e2e:vnext-project": "bash scripts/e2e/vnext-project.sh",
    "e2e:vnext-image-migrate": "bash scripts/e2e/vnext-image-migrate.sh",
    "test:vnext-script-db": "bash scripts/e2e/vnext-script-db.sh",
    "e2e:vnext-script": "bash scripts/e2e/vnext-script-browser.sh",
    "test:vnext-assets-db": "bash scripts/e2e/vnext-assets-db.sh",
    "e2e:vnext-assets": "bash scripts/e2e/vnext-assets-browser.sh",
    "e2e:vnext-assets-api": "bash scripts/e2e/vnext-assets-api-browser.sh",
    "test:vnext-storyboard-db": "bash scripts/e2e/vnext-storyboard-db.sh",
    "e2e:vnext-storyboard": "npm run build:frontend && bash scripts/e2e/vnext-storyboard-browser.sh",
    "test:vnext-control-pack-db": "bash scripts/e2e/vnext-paid-intent-db.sh",
    "e2e:vnext-paid-intent": "bash scripts/e2e/vnext-paid-intent-api.sh",
    "eval:breakdown": "tsx scripts/eval/breakdown/run-eval.mts",
    "test:vnext-seedance-unit": "node --import tsx --test tests/vnext-seedance-provider.test.ts tests/vnext-seedance-workflow.test.ts tests/vnext-seedance-generation.test.ts tests/vnext-seedance-references.test.ts tests/vnext-seedance-routes.test.ts",
    "test:vnext-seedance-db": "bash scripts/e2e/vnext-seedance-db.sh",
    "e2e:vnext-seedance-contract": "bash scripts/e2e/vnext-seedance-contract.sh",
    "test:vnext-video-version-db": "bash scripts/e2e/vnext-video-version-db.sh",
    "e2e:vnext-video-version-contract": "bash scripts/e2e/vnext-video-version-contract.sh",
    "smoke:vnext-seedance-paid": "bash scripts/e2e/vnext-seedance-paid-smoke.sh"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.80.6",
    "@earendil-works/pi-ai": "^0.80.6",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.0",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@node-rs/jieba": "^2.0.1",
    "@volcengine/tos-sdk": "^2.7.7",
    "@xyflow/react": "^12.10.1",
    "@zilliz/milvus2-sdk-node": "^2.5.10",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "sharp": "^0.34.3",
    "typebox": "^1.3.10",
    "undici": "^6.28.0",
    "zod": "^4.0.5"
  },
  "overrides": {
    "axios": "1.18.1",
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@midscene/web": "^1.10.8",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.10",
    "@types/pg": "^8.15.4",
    "playwright": "^1.62.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
