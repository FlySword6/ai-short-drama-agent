+function AssetSearchMatchMeta({ asset, searchActive }: { asset: Asset; searchActive?: boolean }): React.JSX.Element | null {
+  const hasSearchMeta = typeof asset.lexical_hit === "boolean"
+    || typeof asset.semantic_hit === "boolean"
+    || typeof asset.score === "number";
+  if (!hasSearchMeta && !searchActive) return null;
+
+  return (
+    <div className="flex flex-wrap items-center gap-1 text-[11px] text-ink-4" title="检索诊断：只区分词法命中和语义命中">
+      {asset.lexical_hit ? <Badge tone="warning">词法命中</Badge> : null}
+      {asset.semantic_hit ? <Badge tone="agent">语义命中</Badge> : null}
+      {!asset.lexical_hit && !asset.semantic_hit ? <Badge tone="neutral">检索结果</Badge> : null}
+      {typeof asset.score === "number" ? <span>融合分 {formatSearchScore(asset.score, 3)}</span> : null}
+      {!hasSearchMeta ? <span>未返回诊断</span> : null}
+    </div>
+  );
+}
+
+function formatSearchScore(value: number, digits: number): string {
+  return Number.isFinite(value) ? value.toFixed(digits) : "-";
+}
