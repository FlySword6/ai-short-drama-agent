# 本地/offline 与 dev/test Compose 变量兼容样例，不是生产配置真源。
# 正式生产非 secret 位于 deploy/k8s/configmap.yaml；五项 secret 只存 KMS
# shortdrama/v011/production，由 VKE IRSA initContainer 写入内存 emptyDir。
# 标记 [SECRET] 的值不进仓库、聊天、日志或 Kubernetes 清单。

APP_NAME=Shortdrama Dev Test
APP_VERSION=0.1.1
DEBUG=false
SESSION_TTL_HOURS=168
AUTH_PASSWORD_MIN_LENGTH=12
# Closed by default. Open only for a controlled onboarding window, or keep it
# false and configure one or more comma-separated invite codes.
AUTH_REGISTRATION_ENABLED=false
AUTH_REGISTRATION_INVITE_CODES=
# 企业微信登录默认关闭；真实 CorpSecret 只允许经 KMS 注入，不写入此文件。
WECOM_LOGIN_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_CORP_SECRET=  # [SECRET]
WECOM_CALLBACK_URL=
WECOM_STATE_TTL_SECONDS=300
ADMIN_USERNAMES=<lowercase-admin-username>
TRASH_RETENTION_DAYS=180

# Dev/test Compose overrides POSTGRES_HOST to db. Production uses the private
# RDS endpoint and TLS settings from deploy/k8s/configmap.yaml.
DATABASE_URL=
POSTGRES_DB=shortdrama
POSTGRES_USER=shortdrama
POSTGRES_PASSWORD=<long-random-password>  # [SECRET]
# 主线 schema，所有环境固定 app（docs/contracts/environment-governance.md §2，废弃 prod）。
# 千万别填 common——那是团队旧系统的活数据 schema，本应用的库账号对它有写权限。
POSTGRES_SCHEMA=app

# Paid generation remains disabled until a person explicitly enables it.
ALLOW_PAID_GENERATION=false
PAID_GENERATION_BUDGET_FEN=0
PAID_GENERATION_REVIEW_THRESHOLD_FEN=40000

# Only configure providers that have been verified for this environment.
# R195-5 company-account guard. Add newapi only after its company account,
# aliases and prices have been reviewed.
COMPANY_PROVIDER_ALLOWLIST=ark
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=  # [SECRET] 火山方舟 API Key
ARK_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
ARK_VIDEO_MODEL=doubao-seedance-2-0-fast-260128
# Set only after the paid audio capability tier has been verified and approved.
OPENSPEECH_TTS_MODEL=
# Complete URL only after Fable/DC verifies the provider contract; no inferred default.
# Synchronous submit endpoint; there is no async query URL to template.
OPENSPEECH_TTS_ENDPOINT=
OPENSPEECH_TTS_TOKEN=  # [SECRET] 语音控制台 access token(与 ARK_API_KEY 无关;鉴权头是 Bearer;${token},分号)
OPENSPEECH_TTS_APPID=
# Console-assigned cluster; leave empty to use the documented volcano_tts default.
OPENSPEECH_TTS_CLUSTER=
SEED_AUDIO_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/create
SEED_AUDIO_API_KEY=  # [SECRET] 豆包音频生成 v3 API Key
SEED_AUDIO_MODEL=seed-audio-1.0

# MiniMax private-account direct routing has no runtime enable switch after
# FABLE-016. Retained credentials and allowlists are inert historical assets.
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_API_KEY=  # [SECRET]
MINIMAX_GROUP_ID=
MINIMAX_LLM_MODELS=
MINIMAX_IMAGE_MODELS=
MINIMAX_VIDEO_MODELS=
MINIMAX_AUDIO_MODELS=
MINIMAX_AUDIO_VOICE_ID=male-qn-qingse

# Company newapi aggregation gateway. Keep all fields inert until the reviewed
# HTTPS URL, KMS key, exact aliases and internal prices are available.
NEWAPI_GENERATION_ENABLED=false
NEWAPI_BASE_URL=
NEWAPI_APPROVED_BASE_URL_SHA256=
NEWAPI_API_KEY=  # [SECRET]
NEWAPI_GPT_IMAGE_MODELS=
NEWAPI_GEMINI_IMAGE_MODELS=
PRICING_SEED_DEV_DATABASE_IDENTITY_SHA256=
# 本地 dev smoke 专用；test/prod 保持为空。
FABLE007_DEV_ARK_CREDENTIAL_SHA256=
FABLE007_DEV_MINIMAX_CREDENTIAL_SHA256=
FABLE007_DEV_SEED_AUDIO_CREDENTIAL_SHA256=
ARK_LLM_MODEL=doubao-seed-2-1-pro-260628
ARK_LLM_MODELS=
DOUBAO_LLM_MODEL=doubao-seed-2-1-pro-260628
DOUBAO_EMBEDDING_MODEL=doubao-embedding-vision-251215

# Company-owned OpenAI-compatible text gateway. URL and key are runtime
# credentials; this tracked template records key names only.
COL_BASE_URL=  # [SECRET]
COL_APIKEY=  # [SECRET]
COL_TEXT_MODELS=
COL_SCRIPT_BREAKDOWN_MODEL=
COL_PROMPT_DRAFT_MODEL=
COL_PROMPT_TRANSLATE_MODEL=

# Trusted Seedance asset registration is a separate AK/SK OpenAPI flow. It is
# disabled by default and must not reuse ARK_API_KEY.
SEEDANCE_ASSET_REGISTRATION_ENABLED=false
SEEDANCE_ASSET_GROUP_ID=  # 可选；留空时服务按名称幂等创建
SEEDANCE_ASSET_GROUP_NAME=中文在线短剧素材
SEEDANCE_ASSET_GROUP_DESCRIPTION=中文在线 AI 短剧平台登记的图片参考素材
SEEDANCE_ASSET_PROJECT_NAME=default
SEEDANCE_ASSET_REGISTRATION_ENDPOINT=https://ark.cn-beijing.volcengineapi.com
SEEDANCE_ASSET_REGISTRATION_REGION=cn-beijing
VOLCENGINE_ACCESS_KEY_ID=  # [SECRET]
VOLCENGINE_SECRET_ACCESS_KEY=  # [SECRET]
VOLCENGINE_SECURITY_TOKEN=  # [SECRET] 可选，STS 临时凭据使用

# Server-side AI gateway is opt-in. It only drafts and recommends; it does not
# submit paid media-generation tasks. Keep the per-user UTC-day limit bounded.
AI_GATEWAY_ENABLED=false
AI_DAILY_CALL_LIMIT=200

# Optional remote Pi primary provider. The token is managed configuration and
# must never be committed or printed. Rotate any previously exposed token.
PI_REMOTE_API_URL=
PI_REMOTE_API_TOKEN=  # [SECRET]
PI_REMOTE_MODEL=pi-remote

# Permanent media storage. Leave incomplete values empty: generation then fails closed.
TOS_BUCKET=drama-asset
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_SDK_ENDPOINT=tos-cn-beijing.volces.com
TOS_PUBLIC_BASE_URL=https://drama-asset.tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_ACCESS_KEY=  # [SECRET]
TOS_SECRET_KEY=  # [SECRET]

# Optional projection. PostgreSQL remains the source of truth and the app must
# keep working when this block is empty or Milvus is temporarily unavailable.
MILVUS_URI=
MILVUS_USER=
MILVUS_PASSWORD=  # [SECRET]
MILVUS_COLLECTION_ASSET_ENTITY=asset_entity_vectors
MILVUS_COLLECTION_PROJECT_STORYBOARD=project_storyboard_vectors
