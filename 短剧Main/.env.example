# 本文件与 src/config/env.ts 的字段逐项对齐（test/dev-environment.test.ts 有护栏守着）。
# 规则：一个真值都不许有——不写真密码、真 key、云端主机名、真实桶名。
# 每注释说明"干什么 + dev 下填什么"。dev 下 `npm run dev:up` 会把本文件复制成 .env 直接用。

# 应用名，只用于展示和日志。dev 随意。
APP_NAME=Shortdrama Dev
# 版本号。留空 = 自动取仓根 package.json 的 version；只有发布流才显式注入。
APP_VERSION=
# 构建产物对应的 git commit sha，供 /api/v1/health 回答"线上跑的是哪个提交"。
# dev 留空即可（显示 unknown）；镜像里由 Dockerfile 的 GIT_SHA 构建参数注入。
# 只收 7-40 位小写 hex，填别的（分支名、镜像 tag）会让应用启动期直接报错。
APP_COMMIT_SHA=
# 是否开 debug 日志（true/false）。dev 需要排障时可改 true。
DEBUG=false
# API 监听端口。dev 默认 8000。
PORT=8000
# API 监听地址。dev 用本机回环就够；容器化运行时由 compose 覆盖成 0.0.0.0。
HOST=127.0.0.1

# ---- 登录与账号 ----
# 会话有效期（小时）。dev 默认 7 天，少登录几次。
SESSION_TTL_HOURS=168
# 密码最小长度（8-128）。Day-0 引导生成的临时密码也遵守它。
AUTH_PASSWORD_MIN_LENGTH=8
# S57 邮箱自注册始终开放；旧开关只为兼容旧部署解析，不能再作为访问控制。
AUTH_REGISTRATION_ENABLED=true
# 旧版静态邀请码名单已退役。邀请码改由管理员 API 创建、哈希落库；这里留空。
AUTH_REGISTRATION_INVITE_CODES=
# 邮箱验证码一期只支持开发日志模式，不实际发信。生产环境会明确拒绝，等后续邮件服务接入。
AUTH_EMAIL_DELIVERY_MODE=dev_log
# 验证码有效期（秒）与最大验证次数。开发环境可用默认值。
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=600
AUTH_EMAIL_VERIFICATION_MAX_ATTEMPTS=5
# 企业微信登录默认关闭。开启时 CorpID、AgentID、HTTPS 回调与 CorpSecret 必须同时存在。
# CorpSecret 只填本地忽略的 .env；生产只能从 KMS 注入。
WECOM_LOGIN_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_CORP_SECRET=
WECOM_CALLBACK_URL=
WECOM_STATE_TTL_SECONDS=300
# 同一账号能不能同时在多处登录。false=能，true=后登的把先登的挤下线。
# 不配这个键时按 NODE_ENV 推导：生产只留一处，开发和测试允许多处。
# dev 明确写 false：几个人共用一个账号排同一个问题时不该互相踢。
AUTH_SINGLE_ACTIVE_SESSION=false
# development/test/production。生产必须有经过批准的邮件通道；本包不提供。
NODE_ENV=development
# 管理员用户名（逗号分隔，小写）。dev:up 取第一个建 Day-0 管理员，迁移 016 也用它提权。
ADMIN_USERNAMES=admin
# 本机一次性 dev 库的管理员账号，用来登录 5173。用户名以 ADMIN_USERNAMES 第一个为准，
# 这里登记同一个值，供需要「用户名+密码」成对凭据的脚本取用（如 sync-release-plan.mts）。
DEV_ADMIN_USERNAME=admin
# 本机 dev 管理员的固定密码：dev:up 第 3 步建 Day-0 管理员时读它，不再随机生成写文件。
# 占位值，不是任何真实凭据；长度必须 >= AUTH_PASSWORD_MIN_LENGTH（默认 8），留空 dev:up 会停下来。
# 想换成自己的：改这里，再 npm run dev:reset 重建。
DEV_ADMIN_PASSWORD=dev-only-admin-not-a-secret
# 普通成员能否创建项目。dev 想练成员视角可开；管理员不受限。
ALLOW_MEMBER_CREATE_PROJECT=false
# 回收站恢复期（天，1-3650）。服务端和 API 的唯一事实；前端从接口读取。
TRASH_RETENTION_DAYS=180

# ---- 生成 worker 与付费闸 ----
# 自然语言生成编排：dev/test 默认 mock，production 未显式配置时默认 disabled。
# real 会进入既有报价和付费确认链，只能在另行批准的受控验收中开启。
GENERATION_ORCHESTRATION_MODE=mock
# 生成任务轮询间隔（毫秒）与租约秒数。dev 用默认值即可。
GENERATION_WORKER_POLL_INTERVAL_MS=5000
GENERATION_TASK_LEASE_SECONDS=180
# 内部试点资格闸：完整报价、确认和提交都要求登录用户已有正余额与当日剩余额度。
# 这是授权开关，只接受明确布尔值；拼写错误会让服务启动失败，不能静默关闭闸门。
GENERATION_PILOT_CREDIT_GATE_ENABLED=true
# 付费生成总开关。红线：dev 永远 false，生图/生视频/生音频必须真人显式触发。
ALLOW_PAID_GENERATION=false
# 付费预算（分）与人工复核阈值（分）。dev 保持 0 / 默认。
PAID_GENERATION_BUDGET_FEN=0
PAID_GENERATION_REVIEW_THRESHOLD_FEN=40000

# ---- 数据库（dev 只准本机；护栏会拒绝云端 RDS 主机名）----
# 完整连接串，设了就优先于下面的 POSTGRES_* 分拆项。dev 留空。
DATABASE_URL=
# vNext 专用登录连接串。该登录只加入 vnext_app 且必须是 NOINHERIT；
# 不得复用上面的主应用/迁移登录。这里是 dev-pg-init.sql 创建的一次性本机占位账号。
VNEXT_DATABASE_URL=postgresql://vnext_runtime:dev-only-vnext-password-not-a-secret@localhost:5432/shortdrama
# 数据库主机。dev 必须 localhost——docker compose 起的本机 PG14 映射到这个端口。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shortdrama
POSTGRES_USER=shortdrama
# 本机一次性 dev 库的占位密码，不是任何真实凭据；云端密码永远不许写进这里。
POSTGRES_PASSWORD=dev-only-password-not-a-secret
# v0.2.0 主线 schema。千万别填 common——那是团队旧系统的活数据 schema。
POSTGRES_SCHEMA=app
# 连接 TLS。本机 dev 库没有证书，用 disable；连云库才需要 verify-full（dev 也不许连）。
POSTGRES_SSL_MODE=disable
# verify-full 时的 CA 证书路径。dev 留空。
POSTGRES_SSL_ROOT_CERT=

# ---- 火山方舟 Ark / 豆包模型 ----
# 公司账户供应商白名单。当前 dev/test 只开放 Ark 字节系；未来 newapi 公司账户
# 核价并验收后改为 ark,newapi。仅有 key 或模型 ID 不会绕过本门。
COMPANY_PROVIDER_ALLOWLIST=ark
# Ark API 地址。zod 校验不接受空串，这里显式填与代码默认一致的公开地址。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Ark API Key。dev 留空 = 生成与 AI 能力全关，应用照常能跑；要联调填自己的 key。
ARK_API_KEY=
# 生图/生视频/对话模型 ID。dev 留空；联调时按模型适配层合同填。
# 可填一个已验证模型 ID，也可填逗号分隔的已验证模型 ID 白名单。
ARK_IMAGE_MODEL=
ARK_VIDEO_MODEL=
# Seedance 2.5 专用接入点 ep id（折扣绑定在该接入点，提交 model 字段就是这个 ep id；
# 不是裸模型 id）。dev 留空 = 2.5 不进可选模型，2.0 绑定不受影响。
ARK_VIDEO_MODEL_2_5=
# TTS 模型 ID。dev 留空;音频能力会明确拒绝执行,不会猜测或复用图像/视频模型。
OPENSPEECH_TTS_MODEL=
# openspeech TTS 提交端点(同步接口,没有查询 URL)。dev 留空;未验证的路径不许由代码猜测。
OPENSPEECH_TTS_ENDPOINT=
# 语音控制台 access token / appid(成对)。与 ARK_API_KEY 是两回事;鉴权头是 Bearer;${token}(分号)。
OPENSPEECH_TTS_TOKEN=
OPENSPEECH_TTS_APPID=
# 控制台分配的 cluster。dev 留空 = provider 按官方文档使用 volcano_tts。
OPENSPEECH_TTS_CLUSTER=
# 豆包音频生成 v3（新版语音控制台）。三项齐全才启用，和旧 TTS/Ark 凭据无关；
# API Key 仅从本地忽略文件或 KMS 注入。
SEED_AUDIO_ENDPOINT=
SEED_AUDIO_API_KEY=
# 可填一个已验证模型 ID，也可填逗号分隔的已验证模型 ID 白名单（如 seed-audio-1.0,seed-audio-1.0-multilingual）。
SEED_AUDIO_MODEL=

# ---- 阿里云百炼 HappyHorse 参考生视频（预览视频，设计 docs/design/happyhorse-preview-integration-2026-08-18.md）----
# Workspace 级 endpoint 与 API Key 必须同地域；真实 model ID 由部署显式配置，代码不猜。
# 本地开发写 .env（gitignore）；生产经 VKE IRSA KMS 凭据 shortdrama/production 注入。
HAPPYHORSE_API_KEY=
HAPPYHORSE_BASE_URL=
HAPPYHORSE_MODEL=

# ---- MiniMax 多模态 API ----
# FABLE-016 后运行时不再提供 MiniMax 直连开关；以下历史配置仅保留适配器资产，
# 即使 key/allowlist 有值也不会进入生产路由。
# 当前 Bearer API 的官方地址；旧 api.minimax.io 不兼容当前 v1/v2 接口。
MINIMAX_API_HOST=https://api.minimaxi.com
# 只从本地忽略文件或 KMS 注入。仅有 key 不会绕过报价、人工确认或付费闸。
MINIMAX_API_KEY=
# 兼容既有账号导出；当前 v1/v2 API 不把 group_id 放进请求。
MINIMAX_GROUP_ID=
# 必须填账号只读探针核验过的显式 allowlist；仅有 key 不自动开放任何模型。
MINIMAX_LLM_MODELS=
MINIMAX_IMAGE_MODELS=
MINIMAX_VIDEO_MODELS=
MINIMAX_AUDIO_MODELS=
# 系统音色 ID，不是凭据。
MINIMAX_AUDIO_VOICE_ID=male-qn-qingse

# ---- 公司 newapi 聚合网关（OpenAI-compatible image API）----
# 全部默认关闭；只有公司 base URL、独立批准指纹、KMS key、精确 alias 与开关同时到位才可路由。
NEWAPI_GENERATION_ENABLED=false
NEWAPI_BASE_URL=
# 非敏感：经独立批准的规范化 base URL 身份 SHA-256；与 URL 不匹配时绝不发送 key。
NEWAPI_APPROVED_BASE_URL_SHA256=
NEWAPI_API_KEY=
NEWAPI_GPT_IMAGE_MODELS=
NEWAPI_GEMINI_IMAGE_MODELS=

# ---- 公司购买的临时异步图片网关（可替换地址）----
# 只允许公司账户凭据；开关、allowlist、HTTPS 地址和 key 缺一即保持不可用。
SUCHUANG_GENERATION_ENABLED=false
SUCHUANG_BASE_URL=
SUCHUANG_API_KEY=
# 非敏感：protocol|user|host|port|database 的 SHA-256。仅
# dev_smoke_only 定价 promotion 使用；生产必须留空。
PRICING_SEED_DEV_DATABASE_IDENTITY_SHA256=
TIER_UNFREEZE_DEV_TARGET_IDENTITY_SHA256=
TIER_UNFREEZE_DEV_DEPLOYMENT_BASE_URL=
# 测试环境正规解冻通路：独立绑定 test 数据库+schema 与已部署服务。
TIER_UNFREEZE_TEST_ENV_TARGET_IDENTITY_SHA256=
TIER_UNFREEZE_TEST_ENV_DEPLOYMENT_BASE_URL=
TIER_UNFREEZE_TEST_ENV_ARK_CREDENTIAL_SHA256=
# FABLE-007 真实 provider smoke 的独立 dev 凭据 allowlist（只存 SHA-256，不存 key）。
FABLE007_DEV_ARK_CREDENTIAL_SHA256=
FABLE007_DEV_MINIMAX_CREDENTIAL_SHA256=
FABLE007_DEV_SEED_AUDIO_CREDENTIAL_SHA256=

ARK_LLM_MODEL=
# 当前账号已只读核验的对话模型 allowlist；目录 key 由服务端生成，前端不提交 model ID。
ARK_LLM_MODELS=
# 豆包对话/embedding 模型 ID（向量索引用）。dev 留空 = 语义检索走 PG 降级。
DOUBAO_LLM_MODEL=
DOUBAO_EMBEDDING_MODEL=

# ---- 公司 COL 文字网关（OpenAI-compatible）----
# URL 与 API key 都只从本地忽略文件或 KMS 注入；仓库模板只登记键名。
# 开启 AI_GATEWAY_ENABLED 且配置任一 COL 项时，以下六项必须齐全。
COL_BASE_URL=
COL_APIKEY=
COL_TEXT_MODELS=
COL_SCRIPT_BREAKDOWN_MODEL=
COL_PROMPT_DRAFT_MODEL=
COL_PROMPT_TRANSLATE_MODEL=

# ---- Seedance 可信资产登记（AK/SK OpenAPI，与 ARK_API_KEY 是两回事）----
# 默认关闭。dev 全部留空、开关保持 false；ENDPOINT/REGION 有格式校验，填与代码默认一致的公开值。
SEEDANCE_ASSET_REGISTRATION_ENABLED=false
SEEDANCE_ASSET_GROUP_ID=
SEEDANCE_ASSET_GROUP_NAME=中文在线短剧素材
SEEDANCE_ASSET_GROUP_DESCRIPTION=中文在线 AI 短剧平台登记的图片参考素材
SEEDANCE_ASSET_PROJECT_NAME=default
SEEDANCE_ASSET_REGISTRATION_ENDPOINT=https://ark.cn-beijing.volcengineapi.com
SEEDANCE_ASSET_REGISTRATION_REGION=cn-beijing
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
# 临时凭据 token；长期 AK/SK 时留空。dev 留空。
VOLCENGINE_SECURITY_TOKEN=

# ---- 火山 LAS 视频理解（异步解析，默认关闭）----
# false 时视频入库不会向 LAS 提交；打开后仍要求 API key，付费/外部调用由人工触发。
VOLC_LAS_VIDEO_UNDERSTANDING_ENABLED=false
# 留空 = 使用代码内置的 LAS operator 地址；私有部署可显式覆盖。
LAS_BASE_URL=https://operator.las.cn-beijing.volces.com
# LAS Bearer key 与视频理解模型名。dev 留空，不发任何 LAS 请求。
LAS_API_KEY=
LAS_VIDEO_UNDERSTANDING_MODEL=

# ---- Grill Engine（信息不足时的澄清反垃圾引擎）----
# dev 保持 false；开的话同时受日限额约束。
GRILL_ENABLED=false
GRILL_LLM_DAILY_LIMIT=50

# ---- 服务端 AI 网关（只起草与推荐，绝不直接建付费生成任务）----
# dev 保持 false；开的话同时受公司供应商白名单与每日限额约束。
AI_GATEWAY_ENABLED=false
AI_DAILY_CALL_LIMIT=200
GRILL_ENABLED=false
GRILL_LLM_DAILY_LIMIT=50
# quality/fast 继续兼容旧客户端；新目录会把 ARK_LLM_MODELS 与
# MINIMAX_LLM_MODELS 投影成服务端签发的稳定 key，不接受客户端 model ID。
# quality 档 = 生成 AI 图片提示词的默认模型；留空则回落到 ARK_LLM_MODEL。
AI_PROMPT_LLM_QUALITY_MODEL=
AI_PROMPT_LLM_FAST_MODEL=

# ---- 52api 红果榜单（只读、按调用计费）----
# dev 保持 false 且全部留空：没有 key + 没有采购方确认的 endpoint，就不会发出任何上游请求。
TOPIC_RADAR_52API_ENABLED=false
TOPIC_RADAR_52API_KEY=
TOPIC_RADAR_52API_ENDPOINT=
TOPIC_RADAR_52API_CELL_ID=
TOPIC_RADAR_52API_SUB_CELL_ID=
TOPIC_RADAR_52API_TIMEOUT_MS=10000

# ---- 远程 Pi 主供应商（可选）----
# 配了 URL+token 才启用，dev 留空。
PI_REMOTE_API_URL=
PI_REMOTE_API_TOKEN=
PI_REMOTE_MODEL=

# ---- 视觉模型历史别名（本地评估/导入脚本用）----
# 以下都是同一个视觉模型的历代兼容键，dev 全部留空。
doubao_seedence_mini=
DOUBAO_VISION_MODEL=
DOUBAO_LLM_MODEL_2_0_LITE=
DOUBAO_LLM_MODE_2_0_LITE=
DOUBAO_LLM_MODE_2.0lite=

# ---- 火山 TOS 对象存储 ----
# dev 全部留空 = 媒体读写不可用，但应用照常启动、生成 worker 自动暂停。
# 联调时填自己的测试桶；真实桶名/域名不许写进本文件。
TOS_BUCKET=
TOS_ENDPOINT=
TOS_SDK_ENDPOINT=
TOS_PUBLIC_BASE_URL=
# 可选的 CDN/展示域名；必须是 HTTPS，只投影 asset-renditions/v1 独立对象。
# 留空时独立展示对象沿用 TOS_PUBLIC_BASE_URL。
ASSET_MEDIA_DISPLAY_BASE_URL=
TOS_REGION=cn-beijing
TOS_UPLOADER_ACCESS_KEY=
TOS_UPLOADER_SECRET_KEY=
# Legacy compatibility only; prefer the bucket-scoped uploader credential above.
TOS_ACCESS_KEY=
TOS_SECRET_KEY=

# ---- Milvus 向量库（可重建投影，PostgreSQL 才是正式事实）----
# dev 留空 = 语义检索自动走 PostgreSQL 降级路径；要联调可填本机 Milvus 地址。
MILVUS_URI=
MILVUS_USER=
MILVUS_PASSWORD=
# 集合名，保持与代码默认一致即可。
MILVUS_COLLECTION_ASSET_ENTITY=asset_entity_vectors_v2
MILVUS_COLLECTION_PROJECT_STORYBOARD=project_storyboard_vectors
